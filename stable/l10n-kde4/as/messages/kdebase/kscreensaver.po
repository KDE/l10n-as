#: random.cpp:45
#, kde-format
msgid ""
"Usage: %1 [-setup] [args]\n"
"Starts a random screen saver.\n"
"Any arguments (except -setup) are passed on to the screen saver."
msgstr ""
"ব্যৱহাৰ: %1 [-setup] [args]\n"
"এটা যাদৃচ্ছিক স্ক্ৰিনচেইভাৰ আৰম্ভ কৰক।\n"
"যিকোনো তৰ্ক (-setup -ৰ বাহিৰে) স্ক্ৰিনচেইভাৰলে প্ৰদান কৰা হয়।"

#: random.cpp:52
msgid "Start a random KDE screen saver"
msgstr "এটা যাদৃচ্ছিক KDE স্ক্ৰিনচেইভাৰ আৰম্ভ কৰক"

#: random.cpp:67
msgid "Random screen saver"
msgstr "যাদৃচ্ছিক স্ক্ৰিনচেইভাৰ"

#: random.cpp:73
msgid "Setup screen saver"
msgstr "স্ক্ৰিনচেইভাৰ সংস্থাপন কৰক"

#: random.cpp:75
msgid "Run in the specified XWindow"
msgstr "ধাৰ্য্যত XWindow চলোৱা"

#: random.cpp:77
msgid "Run in the root XWindow"
msgstr "ৰুট XWindow -ত চলোৱা"

#: random.cpp:179
msgid "Setup Random Screen Saver"
msgstr "যাদৃচ্ছিক স্ক্ৰিনচেইভাৰ সংস্থাপন কৰক"

#: random.cpp:187
msgid "Use OpenGL screen savers"
msgstr "OpenGL সক্ৰিনচেইভাৰসমূহ ব্যৱহাৰ কৰক"

#: random.cpp:190
msgid "Use screen savers that manipulate the screen"
msgstr "যি স্ক্ৰিনচেইভাৰসমূহ পৰ্দা সলনি কৰে ব্যৱহাৰ কৰক"
