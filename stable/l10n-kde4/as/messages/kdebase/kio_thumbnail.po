#: jpegcreator.cpp:293
msgctxt "@option:check"
msgid "Rotate the image automatically"
msgstr "ছবিটোক স্বচালিতভাৱে ঘুৰাওক"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "নীলমদ্যুতি গোস্বামী"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
