#: kio_floppy.cpp:198
#, kde-format
msgid ""
"Could not access drive %1.\n"
"The drive is still busy.\n"
"Wait until it is inactive and then try again."
msgstr ""
"ড্ৰাইভ %1 অভিগম কৰিব নোৱাৰি।\n"
"ড্ৰাইভ এতিয়াও ব্যস্ত।\n"
"ই নিষ্ক্ৰিয় হোৱা লৈকে অপেক্ষা কৰক আৰু পুনৰ চেষ্টা কৰক।"

#: kio_floppy.cpp:202 kio_floppy.cpp:1116
#, kde-format
msgid ""
"Could not write to file %1.\n"
"The disk in drive %2 is probably full."
msgstr ""
"নথিপত্ৰ %1 -লে লিখিব নোৱাৰি।\n"
"ড্ৰাইভ %2 -ত থকা খুবসম্ভব ভৰ্তি হৈ আছে।"

#: kio_floppy.cpp:212
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2"
msgstr ""
"%1 অভিগম কৰিব নোৱাৰি।\n"
"খুবসম্ভব ড্ৰাইভ %2 -ত কোনো ডিস্ক নাই"

#: kio_floppy.cpp:216
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2 or you do not have enough "
"permissions to access the drive."
msgstr ""
"%1 অভিগম কৰিব নোৱাৰি।\n"
"খুবসম্ভব %2 -ত কোনো ড্ৰাইভ নাই অথবা ড্ৰাইভ অভিগম কৰিবলে আপোনাৰ "
"পৰ্যাপ্ত "
"অনুমতি নাই।"

#: kio_floppy.cpp:220
#, kde-format
msgid ""
"Could not access %1.\n"
"The drive %2 is not supported."
msgstr ""
"%1 অভিগম কৰিব নোৱাৰি।\n"
"ড্ৰাইভ %2 সমৰ্থিত নহয়।"

#: kio_floppy.cpp:225
#, kde-format
msgid ""
"Could not access %1.\n"
"Make sure the floppy in drive %2 is a DOS-formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set "
"correctly (e.g. rwxrwxrwx)."
msgstr ""
"%1 অভিগম কৰিব নোৱাৰি।\n"
"সুনিশ্চিত কৰক যে ড্ৰাইভ %2 -ত থকা ফ্লপি এটা DOS-ফৰমেট কৰা ফ্লপি "
"ডিস্ক \n"
"আৰু ডিভাইচ নথিপত্ৰৰ অনুমতিসমূহ (উদাহৰনস্বৰুপে /dev/fd0) শুদ্ধভাৱে "
"সংহতি "
"কৰা হৈছে (উদাহৰনস্বৰুপে rwxrwxrwx)।"

#: kio_floppy.cpp:229
#, kde-format
msgid ""
"Could not access %1.\n"
"The disk in drive %2 is probably not a DOS-formatted floppy disk."
msgstr ""
"%1 অভিগম কৰিব নোৱাৰি।\n"
"ড্ৰাইভ %2 -ত থকা ডিস্ক খুবসম্ভব DOS-ফৰমেট কৰা ফ্লপি ডিস্ক নহয়।"

#: kio_floppy.cpp:233
#, kde-format
msgid ""
"Access denied.\n"
"Could not write to %1.\n"
"The disk in drive %2 is probably write-protected."
msgstr ""
"অভিগম নাকচ কৰা হৈছে।\n"
"%1 লে লিখিব নোৱাৰি।\n"
"ড্ৰাইভ %2 -ত থকা ডিস্ক খুব সম্ভব লিখা-সুৰক্ষিত।"

#: kio_floppy.cpp:242
#, kde-format
msgid ""
"Could not read boot sector for %1.\n"
"There is probably not any disk in drive %2."
msgstr ""
"%1 -ৰ বাবে বুট অংশ লিখিব নোৱাৰি।\n"
"খুবসম্ভব %2 -ত কোনো ডিস্ক নাই।"

#: kio_floppy.cpp:365
#, kde-format
msgid ""
"Could not start program \"%1\".\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"প্ৰগ্ৰাম \"%1\" আৰম্ভ কৰিব নোৱাৰি।\n"
"সুনিশ্চিত কৰক যে mtools পেকেইজ আপোনাৰ চিস্টেমত সঠিকভাৱে ইনস্টল কৰা "
"হৈছে।"

