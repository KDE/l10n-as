#: plugin_katexmltools.cpp:128
msgid "&Insert Element..."
msgstr "উপাদন সোমাওক (&I)..."

#: plugin_katexmltools.cpp:133
msgid "&Close Element"
msgstr "উপাদন বন্ধ কৰক (&C)"

#: plugin_katexmltools.cpp:138
msgid "Assign Meta &DTD..."
msgstr "মেটা DTD ধাৰ্য্য কৰক (&D)..."

#: plugin_katexmltools.cpp:407
msgid "Assign Meta DTD in XML Format"
msgstr "XML বিন্যাসত মেটা DTD ধাৰ্য্য কৰক"

#: plugin_katexmltools.cpp:412
#, kde-format
msgid ""
"The current file has been identified as a document of type \"%1\". The meta "
"DTD for this document type will now be loaded."
msgstr ""
"বৰ্তমান নথিপত্ৰক ধৰণ \"%1\" -ৰ দস্তাবেজ হিচাপে চিনাক্ত কৰা হৈছে। এই দস্তাবেজ ধৰণৰ "
"বাবে মেটা DTD এতিয়া লোড কৰা হব।"

#: plugin_katexmltools.cpp:415
msgid "Loading XML Meta DTD"
msgstr "XML মেটা DTD লোড কৰা হৈ আছে"

#: plugin_katexmltools.cpp:450
#, kde-format
msgid "The file '%1' could not be opened. The server returned an error."
msgstr "'%1' নথিপত্ৰ খোলিব পৰা নগল। চাৰ্ভাৰে এটা ত্ৰুটি ঘুৰাই দিছে।"

#: plugin_katexmltools.cpp:452 pseudo_dtd.cpp:50 pseudo_dtd.cpp:61
msgid "XML Plugin Error"
msgstr "XML প্লাগিন ত্ৰুটি"

#: plugin_katexmltools.cpp:1011
msgid "Insert XML Element"
msgstr "XML উপাদান সোমাওক"

#: plugin_katexmltools.cpp:1036
msgid ""
"Enter XML tag name and attributes (\"<\", \">\" and closing tag will be "
"supplied):"
msgstr ""
"XML টেগ নাম আৰ বৈশিষ্টসমূহ সোমাওক (\"<\", \">\" আৰু বন্ধ কৰা টেগ যোগান দিয়া হব):"

#: pseudo_dtd.cpp:48
#, kde-format
msgid ""
"The file '%1' could not be parsed. Please check that the file is well-formed "
"XML."
msgstr ""
"নথিপত্ৰ '%1' বিশ্লেষণ কৰিব নোৱাৰি। অনুগ্ৰহ কৰি নীৰিক্ষন কৰক যে নথিপত্ৰটো এটা "
"ভালদৰে গঠিত XML।"

#: pseudo_dtd.cpp:56
#, kde-format
msgid ""
"The file '%1' is not in the expected format. Please check that the file is "
"of this type:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"You can produce such files with dtdparse. See the Kate Plugin documentation "
"for more information."
msgstr ""
"নথিপত্ৰ '%1' আশা কৰা বিন্যাসত নাই। অনুগ্ৰহ কৰি নীৰিক্ষণ কৰক যে নথিপত্ৰটো এই ধৰণৰ:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"আপুনি এনে ধৰণৰ নথিপত্ৰ dtdparse দি উৎপাদন কৰিব পাৰিব। অধিক তথ্যৰ বাবে Kate "
"প্লাগিন তথ্যচিত্ৰ চাওক।"

#: pseudo_dtd.cpp:71
msgid "Analyzing meta DTD..."
msgstr "মেটা DTD বিশ্লেষণ কৰা হৈ আছে..."

#: pseudo_dtd.cpp:71
msgid "Cancel"
msgstr "বাতিল কৰক"

#. i18n: file: ui.rc:4
#. i18n: ectx: Menu (xml)
#: rc.cpp:3
msgid "&XML"
msgstr "XML (&X)"
