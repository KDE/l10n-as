#: solid-hardware.cpp:44
msgid "solid-hardware"
msgstr "কঠিন-হাৰ্ডৱেৰ"

#: solid-hardware.cpp:46
msgid "KDE tool for querying your hardware from the command line"
msgstr "আপোনাৰ হাৰ্ডৱেৰক কমান্ড শাৰীৰ পৰা প্ৰশ্ন কৰিবলে KDE সঁজুলি"

#: solid-hardware.cpp:178
msgid "Syntax Error: Not enough arguments"
msgstr "বাক্যবিন্যাস ত্ৰুটি: পৰ্যাপ্ত তৰ্ক নাই"

#: solid-hardware.cpp:183
msgid "Syntax Error: Too many arguments"
msgstr "বাক্যবিন্যাস ত্ৰুটি: বহু বেছি তৰ্ক"

#: solid-hardware.cpp:194
msgid "Show available commands"
msgstr "উপলব্ধ কমান্ডসমূহ দেখুৱাওক"

#: solid-hardware.cpp:196
msgid "Command (see --commands)"
msgstr "কমান্ড (--commands চাওক)"

#: solid-hardware.cpp:198
msgid "Arguments for command"
msgstr "কমান্ডৰ বাবে তৰ্ক"

#: solid-hardware.cpp:210
msgid "Syntax:"
msgstr "বাক্যবিন্যাস:"

#: solid-hardware.cpp:213
msgid ""
"             # List the hardware available in the system.\n"
"             # - If the 'nonportableinfo' option is specified, the device\n"
"             # properties are listed (be careful, in this case property "
"names\n"
"             # are backend dependent),\n"
"             # - If the 'details' option is specified, the device "
"interfaces\n"
"             # and the corresponding properties are listed in a platform\n"
"             # neutral fashion,\n"
"             # - Otherwise only device UDIs are listed.\n"
msgstr ""
"             # চিস্টেমত উপলব্ধ হাৰ্ডৱেৰ তালিকাভুক্ত কৰক।\n"
"             # - যদি 'nonportableinfo' বিকল্প ধাৰ্য্য কৰা আছে, ডিভাইচ\n"
"             # বৈশিষ্টসমূহ তালিকাভুক্ত কৰা হয় (সাৱধান হ'ব, এই ক্ষেত্ৰত বৈশিষ্ট "
"নামসমূহ\n"
"             # পিছপ্ৰান্তৰ উপৰত নিৰ্ভৰশীল),\n"
"             # - যদি 'details' বিকল্প ধাৰ্য্য কৰা আছে, ডিভাইচ আন্তঃপৃষ্টসমূহ\n"
"             # আৰু আনুষংগিক বৈশিষ্টসমূহ প্লেটফৰ্ম\n"
"             # নিৰপেক্ষ ধৰণত তালিকাভুক্ত কৰা হ'ব,\n"
"             # - নগলে কেৱল ডিভাইচ UDIসমূহ তালিকাভুক্ত কৰা হয়।\n"

#: solid-hardware.cpp:223
msgid ""
"             # Display all the interfaces and properties of the device\n"
"             # corresponding to 'udi' in a platform neutral fashion.\n"
msgstr ""
"             # ডিভাইচৰ সকলো 'udi'  -লে আনুষংগিক আন্তঃপৃষ্ট আৰু বৈশিষ্টসমূহ\n"
"             # এটা প্লেটফৰ্ম নিৰপেক্ষ ধৰণত প্ৰদৰ্শন কৰক।\n"

#: solid-hardware.cpp:227
msgid ""
"             # Display all the properties of the device corresponding to "
"'udi'\n"
"             # (be careful, in this case property names are backend "
"dependent).\n"
msgstr ""
"             # 'udi' লে আনুষংগিক ডিভাইচৰ সকলো বৈশিষ্ট প্ৰদৰ্শন কৰক \n"
"             # (সাৱধান হ'ব, এই ক্ষেত্ৰত বৈশিষ্ট নামসমূহ পিছপ্ৰান্ত নিৰ্ভৰশীল)।\n"

#: solid-hardware.cpp:231
msgid ""
"             # List the UDI of devices corresponding to 'predicate'.\n"
"             # - If 'parentUdi' is specified, the search is restricted to "
"the\n"
"             # branch of the corresponding device,\n"
"             # - Otherwise the search is done on all the devices.\n"
msgstr ""
"             # 'predicate' লে আনুষংগিক UDI ডিভাইচসমূহ তালিকাভুক্ত কৰক।\n"
"             # - যদি 'parentUdi' ধাৰ্য্যত থাকে, সন্ধান আনুষংগিকডিভাইচৰ\n"
"             # শাখালে সীমিত থাকে,\n"
"             # - নহলে সন্ধান সকলো ডিভাইচত কৰা হয়।\n"

#: solid-hardware.cpp:237
msgid ""
"             # If applicable, mount the device corresponding to 'udi'.\n"
msgstr "             # যদি প্ৰযোজ্য, 'udi' লে আনুষংগিকভাৱে ডিভাইচ মাউন্ট কৰক।\n"

#: solid-hardware.cpp:240
msgid ""
"             # If applicable, unmount the device corresponding to 'udi'.\n"
msgstr "             # যদি প্ৰযোজ্য, 'udi' লে আনুষংগিক ডিভাইচ মাউন্ট কৰক।\n"

#: solid-hardware.cpp:243
msgid ""
"             # If applicable, eject the device corresponding to 'udi'.\n"
msgstr "             # যদি প্ৰযোজ্য, 'udi' লে আনুষংগিকভাৱে ডিভাইচ উলিৱাওক।\n"

#: solid-hardware.cpp:314
#, kde-format
msgid "Syntax Error: Unknown command '%1'"
msgstr "বাক্যবিন্যাস ত্ৰুটি: অজ্ঞাত কমান্ড '%1'"

#: solid-hardware.cpp:384
#, kde-format
msgid "Error: %1 does not have the interface StorageAccess."
msgstr "ত্ৰুটি: %1 -ৰ আন্তঃপৃষ্ট সংৰক্ষণঅভিগম নাই।"

#: solid-hardware.cpp:389
#, kde-format
msgid "Error: %1 does not have the interface OpticalDrive."
msgstr "ত্ৰুটি: %1 -ৰ আন্তঃপৃষ্ট আলোকীড্ৰাইভ।"

