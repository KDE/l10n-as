#: kcmxinerama.cpp:55
msgid "kcmxinerama"
msgstr "kcmxinerama"

#: kcmxinerama.cpp:56
msgid "KDE Multiple Monitor Configurator"
msgstr "KDE বহু মনিটৰ সংৰূপক"

#: kcmxinerama.cpp:58
msgid "(c) 2002-2003 George Staikos"
msgstr "(c)২০০২-২০০৩ জৰ্জ স্টাইকচ"

#: kcmxinerama.cpp:60
msgid "George Staikos"
msgstr "জৰ্জ স্টাইকচ"

#: kcmxinerama.cpp:63
msgid ""
"<h1>Multiple Monitors</h1> This module allows you to configure KDE support "
"for multiple monitors."
msgstr ""
"<h1>বহু মনিটৰ</h1> এই মডিউলে আপোনাক বহু মনিটৰৰ বাবে KDE সমৰ্থন সংৰূপণ কৰাৰ অনুমতি "
"দিয়ে।"

#: kcmxinerama.cpp:87
#, kde-format
msgid "Display %1"
msgstr "%1 প্ৰদৰ্শন কৰক"

#: kcmxinerama.cpp:105
msgid "Display Containing the Pointer"
msgstr "পোইন্টাৰ অন্তৰ্ভুক্ত কৰা প্ৰদৰ্শন কৰক"

#: kcmxinerama.cpp:116
msgid ""
"<qt><p>This module is only for configuring systems with a single desktop "
"spread across multiple monitors. You do not appear to have this "
"configuration.</p></qt>"
msgstr ""
"<qt><p>এই মডিউল কেৱল বহু মনিটৰ বিস্তাৰিত এটা ডেস্কটপ থকা চিস্টেমসমূহ সংৰূপণ কৰাৰ "
"বাবে। আপোনাৰ এই সংৰূপ নাই যেন লাগিছে।</p></qt>"

#: kcmxinerama.cpp:180
msgid "Some settings may affect only newly started applications."
msgstr "কিছুমান সংহতিসমূহে হয়তো কেৱল নতুনকে আৰম্ভ হোৱা অনুপ্ৰয়োগসমূহকে প্ৰভাৱ পেলাব।"

#: kcmxinerama.cpp:180
msgid "KDE Multiple Monitors"
msgstr "KDE বহু মনিটৰসমূহ"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "নীলমদ্যুতি গোস্বামী"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "ngoswami@redhat.com"

