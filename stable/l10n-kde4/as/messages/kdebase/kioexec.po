#: main.cpp:44
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - দূৰৱৰ্তী নথিপত্ৰসমূহ খোলে, পৰিৱৰ্তনসমূহ লক্ষ্য কৰে, আপলোডৰ বিষয়ে সোধে"

#: main.cpp:52
msgid "'command' expected.\n"
msgstr "'command' আশা কৰা হৈছে।\n"

#: main.cpp:81
#, kde-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"URL %1\n"
"ক্ষতিগ্ৰস্থ"

#: main.cpp:83
#, kde-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"দূৰৱৰ্তী URL %1\n"
"--tempfiles চুইচৰ লগত অনুমোদিত নহয়"

#: main.cpp:216
#, kde-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"প্ৰত্যাশিত অস্থায়ী নথিপত্ৰ\n"
"%1\n"
"সলনি কৰা হৈছে।\n"
"তথাপিও আপুনি ইয়াক মচি পেলাব বিচাৰে নে?"

#: main.cpp:217 main.cpp:224
msgid "File Changed"
msgstr "নথিপত্ৰ সলনি কৰা হৈছে"

#: main.cpp:217
msgid "Do Not Delete"
msgstr "নমচিব"

#: main.cpp:223
#, kde-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"নথিপত্ৰ\n"
"%1\n"
"সলনি কৰা হৈছে।\n"
"আপুনি পৰিৱতৰ্নসমূহ আপলোড কৰিব বিচাৰে নে?"

#: main.cpp:224
msgid "Upload"
msgstr "আপলোড কৰক"

#: main.cpp:224
msgid "Do Not Upload"
msgstr "আপলোড নকৰিব"

