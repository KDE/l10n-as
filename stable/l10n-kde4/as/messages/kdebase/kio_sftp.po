#: kio_sftp.cpp:200 kio_sftp.cpp:204 kio_sftp.cpp:667
msgid "SFTP Login"
msgstr "SFTP লগিন"

#: kio_sftp.cpp:216
msgid "Use the username input field to answer this question."
msgstr "এই প্ৰশ্নৰ উত্তৰ দিবলে ব্যৱহাৰকাৰী ইনপুট ক্ষেত্ৰ ব্যৱহাৰ কৰক।"

#: kio_sftp.cpp:405
msgid "Could not allocate callbacks"
msgstr "কলবেকসমূহ আবন্টন কৰিব নোৱাৰি"

#: kio_sftp.cpp:465
#, kde-format
msgid "Opening SFTP connection to host %1:%2"
msgstr "হস্ট %1 লে SFTP সংযোগ খোলা হৈ আছে:%2"

#: kio_sftp.cpp:469
msgid "No hostname specified."
msgstr "হস্টনাম ধাৰ্য্য কৰা হোৱা নাই।"

#: kio_sftp.cpp:501
msgid "Could not create a new SSH session."
msgstr "এটা নতুন SSH অধিৱেশন সৃষ্টি কৰিব নোৱাৰি।"

#: kio_sftp.cpp:510 kio_sftp.cpp:515
msgid "Could not set a timeout."
msgstr "এটা সময়অন্ত সংহতি কৰিব নোৱাৰি।"

#: kio_sftp.cpp:522 kio_sftp.cpp:528
msgid "Could not set compression."
msgstr "সংকোচন সংহতি কৰিব নোৱাৰি।"

#: kio_sftp.cpp:535
msgid "Could not set host."
msgstr "হস্ট সংহতি কৰিব নোৱাৰি।"

#: kio_sftp.cpp:542
msgid "Could not set port."
msgstr "পোৰ্ট সংহতি কৰিব নোৱাৰি।"

#: kio_sftp.cpp:551
msgid "Could not set username."
msgstr "ব্যৱহাৰকাৰীনাম সংহতি কৰিব নোৱাৰি।"

#: kio_sftp.cpp:560
msgid "Could not set log verbosity."
msgstr "লগ ভাৰ্বোচিটি সংহতি কৰিব নোৱাৰি।"

#: kio_sftp.cpp:568
msgid "Could not parse the config file."
msgstr "সংৰূপ নথিপত্ৰ বিশ্লেষণ কৰিব নোৱাৰি।"

#: kio_sftp.cpp:603
#, kde-format
msgid ""
"The host key for this server was not found, but another type of key exists.\n"
"An attacker might change the default server key to confuse your client into "
"thinking the key does not exist.\n"
"Please contact your system administrator.\n"
"%1"
msgstr ""
"এই চাৰ্ভাৰৰ বাবে হস্ট চাবি পোৱা নগল, কিন্তু অন্য ধৰণৰ চাবি অস্তিত্ববান।\n"
"এজন আক্ৰমণকাৰীয়ে ক্লাএন্টক বিভ্ৰান্ত কৰিবলে যে চাবি অস্তিত্ববান নহয় অবিকল্পিত চাৰ্ভাৰ "
"চাবি সলনি কৰিব পাৰে।\n"
"অনুগ্ৰহ কৰি আপোনাৰ চিস্টেম প্ৰশাসকক যোগাযোগ কৰক।\n"
"%1"

#: kio_sftp.cpp:614
#, kde-format
msgid ""
"The host key for the server %1 has changed.\n"
"This could either mean that DNS SPOOFING is happening or the IP address for "
"the host and its host key have changed at the same time.\n"
"The fingerprint for the key sent by the remote host is:\n"
" %2\n"
"Please contact your system administrator.\n"
"%3"
msgstr ""
"চাৰ্ভাৰ %1 -ৰ বাবে হস্ট চাবি সলনি হৈছে।\n"
"ই হয় এয়া বুজাই আছে যে DNS SPOOFING চলি আছে অথবা হস্টৰ IP ঠিকনা আৰু ইয়াৰ হস্ট "
"চাবি একে সময়তে সলনি হৈছে। \n"
"দূৰৱৰ্তী হস্টৰ দ্বাৰা পঠোৱা চাবিৰ ফিন্গাৰপ্ৰিন্ট হ'ল: \n"
" %2\n"
"অনুগ্ৰহ কৰি আপোনাৰ চিস্টেম প্ৰশাসকক যোগাযোগ কৰক।\n"
"%3"

#: kio_sftp.cpp:627
msgid "Warning: Cannot verify host's identity."
msgstr "সতৰ্কবাৰ্তা: হস্টৰ পৰিচয় সতাসত্য নিৰূপণ কৰিব নোৱাৰি।"

#: kio_sftp.cpp:628
#, kde-format
msgid ""
"The authenticity of host %1 cannot be established.\n"
"The key fingerprint is: %2\n"
"Are you sure you want to continue connecting?"
msgstr ""
"হস্ট %1 -ৰ শুদ্ধতা সংস্থাপন কৰিব নোৱাৰি।\n"
"চাবি ফিন্গাৰপ্ৰিন্ট হ'ল: %2\n"
"আপুনি নিশ্চিত নে আপুনি সংযোগ কৰা চলাই থাকিব বিচাৰে?"

#: kio_sftp.cpp:659 kio_sftp.cpp:679 kio_sftp.cpp:693 kio_sftp.cpp:739
msgid "Authentication failed."
msgstr "প্ৰমাণীকৰণ ব্যৰ্থ।"

#: kio_sftp.cpp:668
msgid "Please enter your username and password."
msgstr "অনুগ্ৰহ কৰি আপোনাৰ ব্যৱহাৰকাৰীনাম আৰু পাছৱাৰ্ড সোমাওক।"

#: kio_sftp.cpp:670
msgid "site:"
msgstr "ছাইট:"

#: kio_sftp.cpp:710
msgid "Incorrect username or password"
msgstr "ভুল ব্যৱহাৰকাৰীনাম অথবা পাছৱাৰ্ড"

#: kio_sftp.cpp:752
msgid ""
"Unable to request the SFTP subsystem. Make sure SFTP is enabled on the "
"server."
msgstr ""
"SFTP উপপ্ৰণালী অনুৰোধ কৰিবলে ব্যৰ্থ। সুনিশ্চিত কৰক যে SFTP চাৰ্ভাৰত সামৰ্থবান কৰা "
"আছে।"

#: kio_sftp.cpp:760
msgid "Could not initialize the SFTP session."
msgstr "SFTP অধিবেশন আৰম্ভ কৰিব নোৱাৰি।"

#: kio_sftp.cpp:765
#, kde-format
msgid "Successfully connected to %1"
msgstr "%1 -লে সফলভাৱে সংযোগ কৰা হ'ল"

#: kio_sftp.cpp:1291
#, kde-format
msgid ""
"Could not change permissions for\n"
"%1"
msgstr ""
"%1 -ৰ বাবে অনুমতিসমূহ সলনি কৰিব\n"
"নোৱাৰি"

#: kio_sftp.cpp:1464
#, kde-format
msgid "Could not read link: %1"
msgstr "লিঙ্ক পঢ়িব নোৱাৰি: %1 "
