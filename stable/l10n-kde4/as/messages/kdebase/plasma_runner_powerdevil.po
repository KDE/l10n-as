#: PowerDevilRunner.cpp:75
msgid "Lists all power profiles and allows them to be activated"
msgstr "সকলো শক্তি আলেখ্য তালিকাভুক্ত কৰে আৰু সিহতক সক্ৰিয় কৰাৰ অনুমতি দিয়ে"

#: PowerDevilRunner.cpp:77
msgid ""
"Lists system suspend (e.g. sleep, hibernate) options and allows them to be "
"activated"
msgstr ""
"চিস্টেম বাতিল তালিকাভুক্ত কৰে (উদাহৰনস্বৰুপে নিদ্ৰা, হাইবাৰনেইট) বিকল্পসমূহ "
"আৰু সিহতক সক্ৰিয় "
"হোৱাৰ অনুমতি দিয়ে"

#: PowerDevilRunner.cpp:84
msgid "Suspends the system to RAM"
msgstr "চিস্টেমক RAM লে বাতিল কৰে"

#: PowerDevilRunner.cpp:91
msgid "Suspends the system to disk"
msgstr "চিস্টেমক ডিস্কলে বাতিল কৰে"

#: PowerDevilRunner.cpp:98
#, no-c-format
msgid ""
"Lists screen brightness options or sets it to the brightness defined by :q:; "
"e.g. screen brightness 50 would dim the screen to 50% maximum brightness"
msgstr ""
"পৰ্দা উজ্জ্বতা বিকল্পসমূহ জ্বলায় অথবা ইয়াক :q:; ৰে বিৱৰিত উজ্জ্বলতা সংহতি "
"কৰে "
"উদাহৰনস্বৰুপে পৰ্দা উজ্জ্বতা ৫০ -এ পৰ্দাক ৫০% সৰ্বাধিক উজ্জ্বতালে অনুজ্জ্বল "
"কৰিব"

#: PowerDevilRunner.cpp:188
#, kde-format
msgctxt "Note this is a KRunner keyword; %1 is a parameter"
msgid "power profile %1"
msgstr "শক্তি আলেখ্য %1"

#: PowerDevilRunner.cpp:200
#, kde-format
msgid "Set Profile to '%1'"
msgstr "আলেখ্যক '%1' লে সংহতি কৰক"

#: PowerDevilRunner.cpp:207
#, kde-format
msgctxt "Note this is a KRunner keyword; %1 is a parameter"
msgid "screen brightness %1"
msgstr "পৰ্দা উজ্জ্বতা %1"

#: PowerDevilRunner.cpp:209
#, kde-format
msgctxt "Note this is a KRunner keyword; %1 is a parameter"
msgid "dim screen %1"
msgstr "পৰ্দা %1 অনুজ্জ্বল কৰক "

#: PowerDevilRunner.cpp:220
#, kde-format
msgid "Set Brightness to %1"
msgstr "উজ্জ্বলতাক %1 লে সংহতি কৰক"

#: PowerDevilRunner.cpp:230
msgid "Dim screen totally"
msgstr "পৰ্দাক সম্পূৰ্ণভাৱে অনুজ্জ্বল কৰক"

#: PowerDevilRunner.cpp:238
msgid "Dim screen by half"
msgstr "পৰ্দাক অৰ্দ্ধ অনুজ্জ্বল কৰক"

#: PowerDevilRunner.cpp:246
msgid "Turn off screen"
msgstr "পৰ্দক বন্ধ কৰক"

#: PowerDevilRunner.cpp:283
msgid "Suspend to RAM"
msgstr "RAM লে বাতিল কৰক"

#: PowerDevilRunner.cpp:287
