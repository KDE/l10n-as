msgstr "%1 -ৰ বাবে ছবি গেলাৰি সৃষ্টি কৰক"

#: imgallerydialog.cpp:99
msgid "Look"
msgstr "চাওক"

#: imgallerydialog.cpp:100
msgid "Page Look"
msgstr "পৃষ্টা চাওনি"

