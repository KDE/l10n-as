#: kmimetypefinder.cpp:32
msgid "MimeType Finder"
msgstr "MimeType সন্ধানকাৰী"

#: kmimetypefinder.cpp:32
msgid "Gives the mimetype for a given file"
msgstr "এটা প্ৰদান কৰা নথিপত্ৰৰ বাবে mimetype দিয়ে"

#: kmimetypefinder.cpp:37
msgid "Use only the file content for determining the mimetype."
msgstr "mimetype নিৰ্ধাৰন কৰিবলে কেৱল নথিপত্ৰ সমল ব্যৱহাৰ কৰক।"

#: kmimetypefinder.cpp:38
msgid ""
"Whether use the file name only for determining the mimetype. Not used if -c "
"is specified."
msgstr ""
"mimetype নিৰ্ধাৰন কৰিবলে কেৱল নথিপত্ৰ নাম ব্যৱহাৰ কৰা হব নে। ব্যৱহাৰ কৰা নহয় যদি "
"-c দিয়া থাকে।"

#: kmimetypefinder.cpp:39
msgid "The filename to test. '-' to read from stdin."
msgstr "পৰিক্ষা কৰিবলে নথিপত্ৰনাম। stdin -ৰ পৰা পঢ়িবলে '-'।"
