#: globalpaths.cpp:340
#, kde-format
msgid ""
"The path for '%1' has been changed.\n"
"Do you want the files to be moved from '%2' to '%3'?"
msgstr ""
"'%1' -ৰ বাবে পথ সলনি কৰা হৈছে।\n"
"আপুনি নথিপত্ৰসমূহক '%2' -ৰ পৰা '%3' লে স্থানান্তৰৰ কৰিব বিচাৰে নে? "

#: globalpaths.cpp:343
msgctxt "Move files from old to new place"
msgid "Move"
msgstr "স্থানান্তৰ কৰক"

#: globalpaths.cpp:344
msgctxt "Use the new directory but do not move files"
msgid "Do not Move"
msgstr "স্থানান্তৰ নকৰিব"

#: globalpaths.cpp:346
#, kde-format
msgid ""
"The path for '%1' has been changed.\n"
"Do you want to move the directory '%2' to '%3'?"
msgstr ""
"'%1' -ৰ বাবে পথ সলনি কৰা হৈছে।\n"
"আপুনি ডাইৰেকটৰি '%2' -ক  '%3' লে স্থানান্তৰৰ কৰিব বিচাৰে নে? "

#: globalpaths.cpp:349
msgctxt "Move the directory"
msgid "Move"
msgstr "স্থানান্তৰ কৰক"

#: globalpaths.cpp:350
msgctxt "Use the new directory but do not move anything"
msgid "Do not Move"
msgstr "স্থানান্তৰ নকৰিব"

#: globalpaths.cpp:354
msgid "Confirmation Required"
msgstr "সুনিশ্চিতকৰণৰ প্ৰয়োজন"

