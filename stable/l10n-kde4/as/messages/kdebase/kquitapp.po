#: kquitapp.cpp:28
msgid "Command-line application quitter"
msgstr "কমান্ড-শাৰী অনুপ্ৰয়োগ অন্তকাৰী"

#: kquitapp.cpp:29
msgid "Quit a D-Bus enabled application easily"
msgstr "এটা D-Bus সামৰ্থবান অনুপ্ৰয়োগ সহজে বন্ধ কৰক"

#: kquitapp.cpp:30
msgid "(c) 2006, Aaron Seigo"
msgstr "(c) ২০০৬, এৰন চিগো"

#: kquitapp.cpp:31
msgid "Aaron J. Seigo"
msgstr "এৰন জে.সিগো"

#: kquitapp.cpp:31
msgid "Current maintainer"
msgstr "বৰ্তমান ব্যৱস্থাপক"

#: kquitapp.cpp:35
msgid "Full service name, overrides application name provided"
msgstr "সম্পূৰ্ণ সেৱা নাম, প্ৰদান কৰা অনুপ্ৰয়োগ নাম অভাৰৰাইড কৰে"

#: kquitapp.cpp:36
msgid "Path in the D-Bus interface to use"
msgstr "ব্যৱহাৰ কৰিব লগিয়া D-Bus আন্তঃপৃষ্টৰ পথ"

#: kquitapp.cpp:37
msgid "The name of the application to quit"
msgstr "বন্ধ কৰিব লগিয়া অনুপ্ৰয়োগৰ নাম"

#: kquitapp.cpp:64
#, kde-format
msgid "Application %1 could not be found using service %2 and path %3."
msgstr "অনুপ্ৰয়োগ %1 সেৱা %2 আৰু পথ %3 ব্যৱহাৰ কৰি পাব নোৱাৰি।"

#: kquitapp.cpp:70
#, kde-format
msgid ""
"Quitting application %1 failed. Error reported was:\n"
"\n"
"     %2 : %3"
msgstr ""
"%1 অণুপ্ৰয়োগ বন্ধ কৰা ব্যৰ্থ হল। সংবাদন কৰা ত্ৰুটি আছিল:\n"
"\n"
"     %2 : %3"

