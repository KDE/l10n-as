#: audio_plugin.cpp:74
#, kde-format
msgid "An older file named '%1' already exists.\n"
msgstr "'%1' নামক এটা নথিপত্ৰ বৰ্তমানে উপস্থিত আছে ।\n"

#: audio_plugin.cpp:76
#, kde-format
msgid "A similar file named '%1' already exists.\n"
msgstr "'%1' নামক এটা নথিপত্ৰ বৰ্তমানে উপস্থিত আছে ।\n"

#: audio_plugin.cpp:78
#, kde-format
msgid "A newer file named '%1' already exists.\n"
msgstr "'%1' নামক এটা নতুন নথিপত্ৰ বৰ্তমানে আছে ।\n"

#: audio_plugin.cpp:80
msgid "Source File"
msgstr "উৎসৰ নথিপত্ৰ"

#: audio_plugin.cpp:81
msgid "Existing File"
msgstr "ইতিমধ্যে থকা নথিপত্ৰ"

#: audio_plugin.cpp:82
msgid "Would you like to replace the existing file with the one on the right?"
msgstr "বৰ্ত্তমানে থকা নথিপত্ৰক আপুনি সোঁফালে থকা নথিপত্ৰেৰে সলনি কৰিব বিচাৰে নেকি ?"

#: audiopreview.cpp:51
msgid ""
"This audio file is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"এই অ'ডিঅ' নথিপত্ৰ\n"
"স্থানীয় গৃহস্থত সংৰক্ষিত নহয় ।\n"
"তুলি ল'বলৈ এই লেবেলত টিপক ।\n"

#: audiopreview.cpp:57
msgid "Unable to load audio file"
msgstr "অ'ডিঅ' নথিপত্ৰ তুলিব পৰা ন'গ'ল"

