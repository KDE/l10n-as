msgstr "S&ticky Keys"

#: kcmaccess.cpp:369
msgid "Use &sticky keys"
msgstr "sticky keys ব্যৱহাৰ কৰক (&s)"

#: kcmaccess.cpp:375
msgid "&Lock sticky keys"
msgstr "sticky keys ল'ক কৰক (&L)"

