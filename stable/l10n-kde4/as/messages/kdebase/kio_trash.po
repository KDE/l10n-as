#: kcmtrash.cpp:120
msgid "Byte"
msgstr "বাইট"

#: kcmtrash.cpp:122
msgid "KByte"
msgstr "KByte"

#: kcmtrash.cpp:126
msgid "MByte"
msgstr "MByte"

#: kcmtrash.cpp:130
msgid "GByte"
msgstr "GByte"

#: kcmtrash.cpp:134
msgid "TByte"
msgstr "TByte"

#: kcmtrash.cpp:139
#, kde-format
msgctxt ""
"%1 is amount of disk space, %2 the unit, KBytes, MBytes, GBytes, TBytes, etc."
msgid "(%1 %2)"
msgstr "(%1 %2)"

#: kcmtrash.cpp:178 kcmtrash.cpp:278
msgid " day"
msgid_plural " days"
msgstr[0] " দিন"
msgstr[1] " দিনসমূহ"

#: kcmtrash.cpp:269
msgid "Delete files older than:"
msgstr "পুৰনি নথিপত্ৰসমূহ মচি পেলাওক:"

#: kcmtrash.cpp:271
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to allow <b>automatic deletion</b> of files that are "
"older than the value specified. Leave this disabled to <b>not</b> "
"automatically delete any items after a certain timespan</para>"
msgstr ""
"<para>প্ৰদান কৰা মানতকে পুৰনি নথিপত্ৰসমূহ মচি পেলাবলে <b>স্বচালিতভাৱে মচি পেলোৱা</"
"b> -ৰ অনুমতি দিবলে এই বাকচ চেক কৰক। এটা অবধিৰ পিছত যিকোনো বস্তু স্বচালিতভাৱে মচি "
"<b>নেপেলাবলে </b> ইয়াক অসামৰ্থবান ৰাখক। "

#: kcmtrash.cpp:280
msgctxt "@info:whatsthis"
msgid ""
"<para>Set the number of days that files can remain in the trash. Any files "
"older than this will be automatically deleted.</para>"
msgstr ""
"<para>আবৰ্জনাত কিমান দিন নথিপত্ৰসমূহ থাকিব পাৰিব সেয়া সংহতি কৰক। ইয়াতকে পুৰনি "
"যিকোনো নথিপত্ৰ স্বচালিতভাৱে মচি পেলোৱা হ'ব।</para>"

#: kcmtrash.cpp:287
msgid "Limit to maximum size"
msgstr "সৰ্বাধিক আকাৰলে সীমিত কৰক"

#: kcmtrash.cpp:289
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to limit the trash to the maximum amount of disk space "
"that you specify below. Otherwise, it will be unlimited.</para>"
msgstr ""
"<para>আপুনি তলত ধাৰ্য্য কৰা ডিস্ক স্থানৰ সৰ্বাধিক পৰিমাণ সীমিত কৰিবলে এই বাকচ চেক "
"কৰক। নহলে, ই অসীমিত হ'ব।</para>"

#: kcmtrash.cpp:300
msgid "Maximum size:"
msgstr "সৰ্বাধিক আকাৰ:"

#: kcmtrash.cpp:309
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the maximum percent of disk space that will be used for the "
"trash.</para>"
msgstr "<para>ই আবৰ্জনাৰ বাবে ব্যৱহৃত ডিস্ক স্থানৰ সৰ্বাধিক সতাংশ।</para>"

#: kcmtrash.cpp:314
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the calculated amount of disk space that will be allowed for "
"the trash, the maximum.</para>"
msgstr ""
"<para>ই আবৰ্জনাৰ বাবে ধাৰ্য্যত গণনা কৰা ডিস্ক স্থানৰ পৰিমাণ, সৰ্বাধিক।</para>"

#: kcmtrash.cpp:317
msgid "When limit reached:"
msgstr "যেতিয়া সীমা পোৱা গল:"

#: kcmtrash.cpp:321
msgid "Warn Me"
msgstr "মোক সতৰ্ক কৰিব"

#: kcmtrash.cpp:322
msgid "Delete Oldest Files From Trash"
msgstr "আবৰ্জনাৰ পৰা আটাইতকৈ পুৰনি নথিপত্ৰসমূহ মচি পেলাওক"

#: kcmtrash.cpp:323
msgid "Delete Biggest Files From Trash"
msgstr "আবৰ্জনাৰ পৰা আটাইতকৈ ডাঙৰ নথিপত্ৰসমূহ মচি পেলাওক"

#: kcmtrash.cpp:325
msgctxt "@info:whatsthis"
msgid ""
"<para>When the size limit is reached, it will prefer to delete the type of "
"files that you specify, first. If this is set to warn you, it will do so "
"instead of automatically deleting files.</para>"
msgstr ""
"<para>যেতিয়া আকাৰ সীমা পোৱা গল, ই আপুনি ধাৰ্য্য কৰা নথিপত্ৰসমূহৰ ধৰণ মচিবলে পছন্দ "
"কৰিব, প্ৰথমতে। যদি দিয়া ইয়াক আপোনাক সতৰ্ক কৰিবলে ধাৰ্য্য কৰা হয়, ই স্বচালিতভাৱে "
"নথিপত্ৰসমূহ মচি পেলোৱাৰ পৰিৱৰ্তে এয়া কৰিব।</para>"

#: kio_trash_win.cpp:228 kio_trash.cpp:140
msgid "This file is already in the trash bin."
msgstr "এই নথিপত্ৰ ইতিমধ্যৈ আবৰ্জনা টেমাত আছে।"

#: kio_trash_win.cpp:241
msgid "not supported"
msgstr "সমৰ্থিত নহয়"

#: kio_trash_win.cpp:252 kio_trash.cpp:228
msgid "Internal error in copyOrMove, should never happen"
msgstr "কপি অথবা স্থানান্তৰত অভ্যন্তৰীক ত্ৰুটি, কেতিয়াও হ'ব নালাগিব"

#: ktrash.cpp:32
msgid "ktrash"
msgstr "ktrash"

#: ktrash.cpp:34
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kioclient move "
"'url' trash:/\""
msgstr ""
"KDE আবৰ্জনা টেমা নিয়ন্ত্ৰণ কৰিবলে সহায়ক প্ৰগ্ৰাম\n"
"টোকা: আবৰ্জনালে নথিপত্ৰসমূহ স্থানান্তৰ কৰিবলে, ktrash ব্যৱহাৰ নকৰিব,  \"kioclient "
"move 'url' trash:/\" ব্যৱহাৰ কৰক"

#: ktrash.cpp:38
msgid "Empty the contents of the trash"
msgstr "আবৰ্জনাৰ সমলসমূহ খালি কৰক"

#: ktrash.cpp:40
msgid "Restore a trashed file to its original location"
msgstr "এটা আবৰ্জিত নথিপত্ৰক ইয়াৰ প্ৰকৃত অৱস্থানলে পুনৰ সংৰক্ষণ কৰক"

#: ktrash.cpp:42
msgid "Ignored"
msgstr "উপেক্ষা কৰা হৈছে"

#: trashimpl.cpp:1125
msgid ""
"The trash has reached its maximum size!\n"
"Cleanup the trash manually."
msgstr ""
"আবৰ্জনায় তাৰ সৰ্বাধিক আকাৰ পাই গৈছে!\n"
"আবৰ্জনাক হস্তচালিতভাৱে সফা কৰক।"

#: trashimpl.cpp:1136
msgid "The file is too large to be trashed."
msgstr "নথিপত্ৰটো আবৰ্জনা কৰিবৰ বাবে অতি ডাঙৰ।"

#: kio_trash.cpp:92 kio_trash.cpp:155 kio_trash.cpp:307 kio_trash.cpp:339
#: kio_trash.cpp:505 kio_trash.cpp:517
#, kde-format
msgid "Malformed URL %1"
msgstr "ক্ষতিগ্ৰস্থ URL %1"

#: kio_trash.cpp:111
#, kde-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"ডাইৰেকটৰি %1 এতিয়া আৰু অস্তিত্ববান নহয়, সেয়েহে এই বস্তুক ইয়াৰ প্ৰকৃত স্থানলে পুনৰ "
"সংৰক্ষণ কৰাটো সম্ভব নহয়। আপুনি সেই ডাইৰেকটৰি হয় পুনৰ সৃষ্টি কৰিব পাৰিব আৰু পুনৰ "
"সংৰক্ষণ কাৰ্য্য আকো ব্যৱহাৰ কৰিব পাৰিব, অথবা বস্তুটোক অন্য কবাত ড্ৰেগ কৰিব পাৰিব "
"ইয়াক পুনৰ সংৰক্ষণ কৰিবলে।"
