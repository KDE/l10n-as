#: eventmonitor.cpp:69
msgid "Indexing files for fast searching. This process may take a while."
msgstr ""
"দ্ৰুত সন্ধানৰ বাবে নথিপত্ৰসমূহ সূচনা কৰা হৈ আছে। এই প্ৰক্ৰিয়ায় অকন সময় লব "
"পাৰে।"

#: eventmonitor.cpp:98 eventmonitor.cpp:127
msgid "Resuming indexing of files for fast searching."
msgstr "দ্ৰুত সন্ধানৰ বাবে নথিপত্ৰসমূহৰ সূচনা চলাই থকা হৈছে।"

#: eventmonitor.cpp:105
msgid "Suspending the indexing of files to preserve resources."
msgstr "সম্পদসমূহ সংৰক্ষণৰ বাবে নথিপত্ৰসমূহ সূচনা বাতিল কৰা হৈছে।"

#: eventmonitor.cpp:119
#, kde-format
msgid "Disk space is running low (%1 left). Suspending indexing of files."
msgstr "ডিস্ক স্থান কম হৈ আছে (%1 বাকি)। নথিপত্ৰসমূহৰ সূচনা বাতিল কৰা হৈ আছে।"

#: eventmonitor.cpp:147
#, kde-format
msgctxt "@info %1 is a duration formatted using KLocale::prettyFormatDuration"
msgid "Initial indexing of files for fast searching finished in %1"
msgstr "দ্ৰুত সন্ধানৰ বাবে নথিপত্ৰসমূহৰ আৰম্ভণি সূচনা %1 -ত শেষ হৈছে"

#: indexer/main.cpp:44
msgid "NepomukIndexer"
msgstr "NepomukIndexer"

#: indexer/main.cpp:46
msgid ""
"NepomukIndexer indexes the contents of a file and saves the results in "
"Nepomuk"
msgstr ""
"NepomukIndexer -এ এটা নথিপত্ৰ সমলসমূহ সূচনা কৰে আৰু ফলাফলসমূহক Nepomuk -ত "
"সংৰক্ষণ কৰে"

#: indexer/main.cpp:48
msgid "(C) 2011, Vishesh Handa"
msgstr "(C) ২০১১, ভিশেষ হান্ডা"

#: indexer/main.cpp:49
msgid "Vishesh Handa"
msgstr "ভিশেষ হান্ডা"

#: indexer/main.cpp:49
msgid "Current maintainer"
msgstr "বৰ্তমান ব্যৱস্থাপক"

#: indexer/main.cpp:50
msgid "Sebastian Trüg"
msgstr "চিবেচটিয়ান ট্ৰুগ"

#: indexer/main.cpp:50
msgid "Developer"
msgstr "উন্নয়নকাৰী"

#: indexer/main.cpp:55
msgid "The URI provided will be forced on the resource"
msgstr "প্ৰদান কৰা URL সম্পদত বাধ্য কৰা হব"

#: indexer/main.cpp:56
msgid "The modification time of the resource in time_t format"
msgstr "সম্পদৰ সলনি কৰা সময় time_t বিন্যাসত"

#: indexer/main.cpp:57
msgid "The URL of the file to be indexed"
msgstr "সূচনা কৰিব লগিয়া নথিপত্ৰৰ URL"

#: indexer/main.cpp:58
msgid "Remove all indexed data of the URL provided"
msgstr "প্ৰদান কৰা URL সকলো সূচিত তথ্য আতৰাওক"

#: strigiservice.cpp:158
msgctxt "@info:status"
msgid "File indexer is suspended"
msgstr "নথিপত্ৰ সূচকক বাতিল কৰা হৈছে"

