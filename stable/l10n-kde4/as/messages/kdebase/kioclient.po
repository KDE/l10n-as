#: kioclient.cpp:42
msgid "KIO Client"
msgstr "KIO ক্লাএন্ট"

#: kioclient.cpp:43
msgid "Command-line tool for network-transparent operations"
msgstr "নেটৱাৰ্ক স্বচ্ছ কাৰ্য্যসমূহৰ বাবে কমান্ড-শাৰী সঁজুলি"

#: kioclient.cpp:54
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"বাক্যবিন্যাস:\n"

#: kioclient.cpp:55
msgid ""
"  kioclient openProperties 'url'\n"
"            # Opens a properties menu\n"
"\n"
msgstr ""
"  kioclient openProperties 'url'\n"
"            # এটা বৈশিষ্টসমূহ মেনু খোলে\n"
"\n"

#: kioclient.cpp:57
msgid ""
"  kioclient exec 'url' ['mimetype']\n"
"            # Tries to open the document pointed to by 'url', in the "
"application\n"
"            #   associated with it in KDE. You may omit 'mimetype'.\n"
"            #   In this case the mimetype is determined\n"
"            #   automatically. Of course URL may be the URL of a\n"
"            #   document, or it may be a *.desktop file.\n"
"            #   'url' can be an executable, too.\n"
msgstr ""
"  kioclient exec 'url' ['mimetype']\n"
"            #  অনুপ্ৰয়োগত, 'url' -এ চিহ্নিত কৰা দস্তাবেজ খোলিব চেষ্টা কৰে \n"
"            #   ইয়াৰ লগত KDE -ত জড়িত।  আপুনি 'mimetype' বাদ দিব পাৰে।\n"
"            #  এই ক্ষেত্ৰত mimetype স্বচালিতভাৱে\n"
"            #   নিৰ্ধাৰন হয়। নিশ্চয় URL দস্তাবেজৰ URL হ'ব পাৰে,\n"
"            #   অথবা ই এটা *.desktop নথিপত্ৰ হ'ব পাৰে।\n"
"            #   'url' প্ৰেৰণ কৰিব পৰাও হ'ব পাৰে।\n"

#: kioclient.cpp:64
msgid ""
"  kioclient move 'src' 'dest'\n"
"            # Moves the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
msgstr ""
"  kioclient move 'src' 'dest'\n"
"            #  URL 'src' -ক 'dest' -লে স্থানান্তৰ কৰে।\n"
"            #   'src'  URLসমূহৰ এটা তালিকা হ'ব পাৰে।\n"

#: kioclient.cpp:67
msgid ""
"            #   'dest' may be \"trash:/\" to move the files\n"
"            #   to the trash.\n"
msgstr ""
"            #   'dest'  \"trash:/\"  হ'ব পাৰে নথিপত্ৰক\n"
"            #   আবৰ্জনালে স্থানান্তৰ কৰিবলে।\n"

#: kioclient.cpp:69
msgid ""
"            #   the short version kioclient mv\n"
"            #   is also available.\n"
"\n"
msgstr ""
"            #   kioclient mv -ৰ সৰু সংস্কৰণ\n"
"            #   উপলব্ধ।\n"
"\n"

#: kioclient.cpp:71
msgid ""
"  kioclient download ['src']\n"
"            # Copies the URL 'src' to a user-specified location'.\n"
"            #   'src' may be a list of URLs, if not present then\n"
"            #   a URL will be requested.\n"
"\n"
msgstr ""
"  kioclient ডাউনলোড ['src']\n"
"            #  URL 'src' -ক এটা ব্যৱহাৰকাৰী ধাৰ্য্যত অৱস্থানলে কপি কৰে।\n"
"            #   'src' URLসমূহৰ এটা তালিকা হব পাৰে, যদি উপস্থিত নহয় তেন্তে\n"
"            #   এটা URL অনুৰোধ কৰা হ'ব।\n"
"\n"

#: kioclient.cpp:75
msgid ""
"  kioclient copy 'src' 'dest'\n"
"            # Copies the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
msgstr ""
"  kioclient copy 'src' 'dest'\n"
"            # URL 'src' -ক 'dest' লে কপি কৰে।\n"
"            #   'src'  URLসমূহৰ এটা তালিকা হ'ব পাৰে।\n"

#: kioclient.cpp:78
msgid ""
"            #   the short version kioclient cp\n"
"            #   is also available.\n"
"\n"
msgstr ""
"            #   kioclient cp -ৰ সৰু সংস্কৰণ\n"
"            #   উপলব্ধ।\n"
"\n"

#: kioclient.cpp:80
msgid ""
"  kioclient cat 'url'\n"
"            # Writes out the contents of 'url' to stdout\n"
"\n"
msgstr ""
"  kioclient cat 'url'\n"
"            #  'url'  -ৰ সমলসমূহ stdout লে লিখে\n"
"\n"

#: kioclient.cpp:82
msgid ""
"  kioclient remove 'url'\n"
"            # Removes the URL\n"
"            #   'url' may be a list of URLs.\n"
msgstr ""
"  kioclient remove 'url'\n"
"            # URL -ক আতৰায়\n"
"            #   'url'  URLসমূহৰ এটা তালিকা হ'ব পাৰে।\n"

#: kioclient.cpp:85
msgid ""
"            #   the short version kioclient rm\n"
"            #   is also available.\n"
"\n"
msgstr ""
"            #   kioclient rm -ৰ সৰু সংস্কৰণ\n"
"            #   উপলব্ধ।\n"
"\n"

#: kioclient.cpp:88
msgid ""
"*** Examples:\n"
"  kioclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
"             // Mounts the CDROM\n"
"\n"
msgstr ""
"*** উদাহৰনসমূহ:\n"
"  kioclient exec file:/root/Desktop/cdrom.desktop \"অবিকল্পিত মাউন্ট কৰক\"\n"
"             // CDROM -ক মাউন্ট কৰে\n"
"\n"

#: kioclient.cpp:91
msgid ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             // Opens the file with default binding\n"
"\n"
msgstr ""
"  kioclient exec file:/home/weis/data/test.html\n"
"             //নথিপত্ৰক অবিকল্পিত বান্ধনীৰ হৈতে খোলে\n"
"\n"

#: kioclient.cpp:93
msgid ""
"  kioclient exec file:/home/weis/data/test.html Netscape\n"
"             // Opens the file with netscape\n"
"\n"
msgstr ""
"  kioclient exec file:/home/weis/data/test.html Netscape\n"
"             // নথিপত্ৰক netscape -ৰ হৈতে খোলে\n"
"\n"

#: kioclient.cpp:95
msgid ""
"  kioclient exec ftp://localhost/\n"
"             // Opens new window with URL\n"
"\n"
msgstr ""
"  kioclient exec ftp://localhost/\n"
"             // URL -ৰ হৈতে এটা নতুন উইন্ডো খোলে\n"
"\n"

#: kioclient.cpp:97
msgid ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             // Starts emacs\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Desktop/emacs.desktop\n"
"             //emacs আৰম্ভ কৰে\n"
"\n"

#: kioclient.cpp:99
msgid ""
"  kioclient exec file:/root/Desktop/cdrom.desktop\n"
"             // Opens the CDROM's mount directory\n"
"\n"
msgstr ""
"  kioclient exec file:/root/Desktop/cdrom.desktop\n"
"             // CDROM -ৰ মাউন্ট ডাইৰেকটৰি\n"
"\n"

#: kioclient.cpp:101
msgid ""
"  kioclient exec .\n"
"             // Opens the current directory. Very convenient.\n"
"\n"
msgstr ""
"  kioclient exec .\n"
"             // বৰ্তমান ডাইৰেকটৰি। বহুত সুবিধাজনক।\n"
"\n"

#: kioclient.cpp:112
msgid "Non-interactive use: no message boxes"
msgstr "অভাৱ-বিনিময়ী ব্যৱহাৰ: কোনো বাৰ্তা বাকচ নাই"

#: kioclient.cpp:114
msgid "Overwrite destination if it exists (for copy and move)"
msgstr "লক্ষ্য পুনৰ লিখক যদি ই অস্তিত্ববান (কপি আৰু স্থানান্তৰৰ বাবে)"

#: kioclient.cpp:117
msgid "URL or URLs"
msgstr "URL অথবা URLসমূহ"

#: kioclient.cpp:119 kioclient.cpp:122
msgid "Source URL or URLs"
msgstr "উৎস URL অথবা URLসমূহ"

#: kioclient.cpp:120 kioclient.cpp:123
msgid "Destination URL"
msgstr "লক্ষ্য URL"

#: kioclient.cpp:125
msgid "Show available commands"
msgstr "উপলব্ধ কমান্ডসমূহ দেখুৱাওক"

#: kioclient.cpp:126
msgid "Command (see --commands)"
msgstr "কমান্ড (--commands চাওক)"

#: kioclient.cpp:127
msgid "Arguments for command"
msgstr "কমান্ডৰ বাবে তৰ্ক"

#: kioclient.cpp:162
msgid "Syntax Error: Not enough arguments\n"
msgstr "বাক্যবিন্যাস ত্ৰুটি: পৰ্যাপ্ত তৰ্ক নাই\n"

#: kioclient.cpp:167
msgid "Syntax Error: Too many arguments\n"
msgstr "বাক্যবিন্যাস ত্ৰুটি: বহু বেছি তৰ্ক\n"

#: kioclient.cpp:319
msgid "Unable to download from an invalid URL."
msgstr "এটা অবৈধ URL -ৰ পৰা ডাউনলোড কৰিবলে ব্যৰ্থ।"

#: kioclient.cpp:362
#, kde-format
msgid "Syntax Error: Unknown command '%1'\n"
msgstr "বাক্যবিন্যাস ত্ৰুটি: অজ্ঞাত কমান্ড '%1'\n"
