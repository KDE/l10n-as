#: kio_nepomuk.cpp:117
#, kde-format
msgctxt "@info"
msgid ""
"Please insert the removable medium <resource>%1</resource> to access this "
"file."
msgstr ""
"এই নথিপত্ৰ অভিগম কৰিবলে অনুগ্ৰহ কৰি আতৰাব পৰা মাধ্যম <resource>%1</resource> "
"সোমাওক।"

#: kio_nepomuk.cpp:137
msgid ""
"Do you really want to delete the resource and all relations to and from it?"
msgstr "আপুনি সঁচাকে সম্পদ আৰু ইয়ালে আৰু ইয়াৰ পৰা সকলো সম্পৰ্ক মচি পেলাব বিচাৰে?"

#: kio_nepomuk.cpp:140
msgid "Delete Resource"
msgstr "সম্পদ মচি পেলাওক"

#: kio_nepomuk.cpp:277
msgid ""
"The Nepomuk system is not activated. Unable to answer queries without it."
msgstr "Nepomuk চিস্টেম সক্ৰিয় নহয়। ইয়াৰ বাহিৰে প্ৰশ্নৰ উত্তৰ দিবলে অক্ষম।"

