#: kwriteconfig.cpp:35
msgid "KWriteConfig"
msgstr "KWriteConfig"

#: kwriteconfig.cpp:37
msgid "Write KConfig entries - for use in shell scripts"
msgstr "KConfig প্ৰবিষ্টিসমূহ লিখক - শ্বেল স্ক্ৰিপ্টসমূহত ব্যৱহাৰৰ বাবে"

#: kwriteconfig.cpp:39
msgid "(c) 2001 Red Hat, Inc. & Luís Pedro Coelho"
msgstr "(c) ২০০১ Red Hat, Inc. & লুই পেড্ৰো চিলহো"

#: kwriteconfig.cpp:40
msgid "Luís Pedro Coelho"
msgstr "লুই পেড্ৰো চিলহো"

#: kwriteconfig.cpp:41
msgid "Bernhard Rosenkraenzer"
msgstr "বাৰ্নহাৰ্ড ৰচেনক্ৰিন্জাৰ"

#: kwriteconfig.cpp:41
msgid "Wrote kreadconfig on which this is based"
msgstr "kreadconfig লিখা হৈছিল যাৰ উপৰত ই ভিত্তিয়"

#: kwriteconfig.cpp:47
msgid "Use <file> instead of global config"
msgstr "বিশ্বব্যাপী config -ৰ পৰিৱৰ্তে <file> ব্যৱহাৰ কৰক "

#: kwriteconfig.cpp:48
msgid "Group to look in. Use repeatedly for nested groups."
msgstr "চাব লগিয়া দলটো। নেস্টেড দলসমূহৰ বাবে বাৰে বাৰে ব্যৱহাৰ কৰক।"

#: kwriteconfig.cpp:49
msgid "Key to look for"
msgstr "চাব লগিয়া চাবি"

#: kwriteconfig.cpp:50
msgid ""
"Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a "
"string"
msgstr ""
"চলকৰ ধৰণ। বুলিয়ানৰ বাবে \"bool\" ব্যৱহাৰ কৰক, অন্যথা ইয়াক স্ট্ৰিং ধৰা হ'ব"

#: kwriteconfig.cpp:51
msgid "The value to write. Mandatory, on a shell use '' for empty"
msgstr ""
"লিখিব লগিয়া মানটো। বাধ্যতামূলক, এটা শ্বেলত ৰিক্তৰ বাবে '' ব্যৱহাৰ কৰক"

