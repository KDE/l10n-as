#. i18n: file: snippet_repository.ui:41
#. i18n: ectx: property (text), widget (KPushButton, btnGHNS)
#: rc.cpp:9
msgid "Get New Snippets..."
msgstr "নতুন স্নিপেটসমূহ প্ৰাপ্ত কৰক..."

#. i18n: file: snippet_repository.ui:53
#. i18n: ectx: property (text), widget (KPushButton, btnCopy)
#: rc.cpp:12
msgid "Copy to repository"
msgstr "ভঁৰাললে কপি কৰক"

#: repository.cpp:181
msgid "all file types"
msgstr "সকলো নথিপত্ৰ ধৰণ"

#: repository.cpp:185
#, kde-format
msgid "!TAINTED!:%1"
msgstr "!দাগী!:%1"

#: repository.cpp:195
#, kde-format
msgid ""
"%1 (%2)\n"
"content license: %3\n"
"repository license: %4 authors: %5"
msgstr ""
"%1 (%2)\n"
"সমল অনুজ্ঞা: %3\n"
"ভঁৰাল অণুজ্ঞা: %4 লেখকসমূহ: %5"

#: repository.cpp:356
#, kde-format
msgid ""
"Do you really want to delete the file '%1' from the repository? This action "
"is irreversible."
msgstr ""
"আপুনি সঁচাকে নথিপত্ৰ '%1' -ক ভঁৰালৰ পৰা আতৰাব বিচাৰে নে? এই কাৰ্য্য ঘুৰাব "
"নোৱাৰি।"

#: repository.cpp:357
msgid "Deleting snippet file"
msgstr "স্নিপেট নথিপত্ৰ মচি পেলোৱা"

#: repository.cpp:367
#, kde-format
msgid ""
"Editor application for file '%1' with mimetype 'application/x-ktesnippets' "
"could not be started"
msgstr ""
"mimetype 'application/x-ktesnippets' -ৰ নথিপত্ৰ  '%1' -ৰ বাবে সম্পাদক "
"অনুপ্ৰয়োগ "
"আৰম্ভ কৰিব পৰা নগল"

#: repository.cpp:394 repository.cpp:401 repository.cpp:557 repository.cpp:585
msgid ""
"Editor application for new file with mimetype 'application/x-ktesnippets' "
"could not be started"
msgstr ""
"mimetype 'application/x-ktesnippets' -ৰ হৈতে নতুন নথিপত্ৰৰ বাবে সম্পাদক "
"অনুপ্ৰয়োগ "
"আৰম্ভ কৰিব পৰা নগল"

#: repository.cpp:409
msgid "No file specified"
msgstr "কোনো নথিপত্ৰ ধাৰ্য্য কৰা হোৱা নাই"

#: repository.cpp:423
msgid "It was not possible to create a unique file name for the imported file"
msgstr ""
"ইমপোৰ্ট কৰা নথিপত্ৰৰ বাবে এটা অবিকল্প নথিপত্ৰ নাম সৃষ্টি কৰা সম্ভব নাছিল"

#: repository.cpp:426
msgid "Imported file has been renamed because of a name conflict"
msgstr "ইমপোৰ্ট কৰা নথিপত্ৰৰ এটা নাম দন্দৰ বাবে পুনৰ নামাকৰন কৰা হৈছে"

#: repository.cpp:433
msgid "File could not be copied to repository"
msgstr "নথিপত্ৰক ভঁৰাললে কপি কৰিব পৰা নগল"

