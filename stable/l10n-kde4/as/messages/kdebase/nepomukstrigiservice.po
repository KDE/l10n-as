msgctxt "@info:status"
msgid "Strigi is currently indexing files"
msgstr "Strigi -এ বৰ্তমানে নথিপত্ৰসমূহ সূচনা কৰি আছে"

#: strigiservice.cpp:168
#, kde-format
msgctxt "@info:status"
msgid "Strigi is currently indexing files in folder %1"
msgstr "Strigi -এ বৰ্তমানে নথিপত্ৰসমূহ ফোল্ডাৰ %1 -ত সূচনা কৰি আছে"

#: strigiservice.cpp:170
#, kde-format
msgctxt "@info:status"
msgid "Strigi is currently indexing files in folder %1 (%2)"
msgstr "Strigi -এ বৰ্তমানে নথিপত্ৰসমূহ ফোল্ডাৰ %1 (%2) -ত সূচনা কৰি আছে"

#: strigiservice.cpp:174
msgctxt "@info:status"
msgid "File indexer is idle"
msgstr "নথিপত্ৰ সূচক অলস অৱস্থাত আছে"

