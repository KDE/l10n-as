#: image_plugin.cpp:72
msgid "You want to overwrite the left picture with the one on the right."
msgstr "আপুনি বাওঁফালৰ ছবিক সোঁফালৰ ছবিৰে পুনঃ লিখিব বিচাৰিছে ।"

#: imagevisualizer.cpp:45
msgid ""
"This picture is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"এই ছবি\n"
"স্থানীয় গৃহস্থত সংৰক্ষিত নহয় ।\n"
"তুলি ল'বলৈ এই লেবেলত টিপক ।\n"

#: imagevisualizer.cpp:53
msgid "Unable to load image"
msgstr "ছবি তুলি ল'ব পৰা নাযায়"

