#: thumbnail.cpp:123
msgid "kio_thumbmail"
msgstr "kio_thumbmail"

#: thumbnail.cpp:187
msgid "No MIME Type specified."
msgstr "কোনো MIME ধৰণ ধাৰ্য্য কৰা হোৱা নাই।"

#: thumbnail.cpp:196
msgid "No or invalid size specified."
msgstr "কোনো আকাৰ ধাৰ্য্য কৰা হোৱা নাই বা অবৈধ আকাৰ ধাৰ্য্য কৰা হৈছে।"

#: thumbnail.cpp:251
msgid "Cannot create thumbnail for directory"
msgstr "ডাইৰেকটৰিৰ বাবে থাম্বনেইল সৃষ্টি কৰিব নোৱাৰি"

#: thumbnail.cpp:263
msgid "No plugin specified."
msgstr "কোনো প্লাগিন ধাৰ্য্য কৰা হোৱা নাই।"

#: thumbnail.cpp:269
#, kde-format
msgid "Cannot load ThumbCreator %1"
msgstr "ThumbCreator %1 লোড কৰিব নোৱাৰি"

#: thumbnail.cpp:278
#, kde-format
msgid "Cannot create thumbnail for %1"
msgstr "%1 -ৰ বাবে থাম্বনেইল সৃষ্টি কৰিব নোৱাৰি"

#: thumbnail.cpp:316
msgid "Failed to create a thumbnail."
msgstr "এটা থাম্বনেইল সৃষ্টি কৰিবলে ব্যৰ্থ।"

#: thumbnail.cpp:328
msgid "Could not write image."
msgstr "ছবি লিখিব নোৱাৰি।"

#: thumbnail.cpp:353
#, kde-format
msgid "Failed to attach to shared memory segment %1"
msgstr "অংশীদাৰী মেমেৰি অংশ %1 লে সংলঘ্ন কৰিবলে ব্যৰ্থ"

#: thumbnail.cpp:357
msgid "Image is too big for the shared memory segment"
msgstr "অংশীদাৰী মেমৰি অংশৰ বাবে ছবি বহুত ডাঙৰ"
