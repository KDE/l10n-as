#: krdb.cpp:251
#, kde-format
msgid ""
"# created by KDE, %1\n"
"#\n"
"# If you do not want KDE to override your GTK settings, select\n"
"# Appearance -> Colors in the System Settings and disable the checkbox\n"
"# \"Apply colors to non-KDE4 applications\"\n"
"#\n"
"#\n"
msgstr ""
"# KDE দ্বাৰা সৃষ্টি কৰা হৈছে, %1\n"
"#\n"
"# যদি আপুনি KDE -ক আপোনাৰ GTK সংহতিসমূহ অভাৰৰাইড কৰিব দিব নিবিচাৰে, \n"
"# চিস্টেম সংহতিসমূহত ৰূপ -> ৰঙসমূহ  বাছক আৰু\n"
"# \"non-KDE4 অনুপ্ৰয়োগসমূহলে ৰঙসমূহ প্ৰয়োগ কৰক\" চেকবাকচ অসামৰ্থবান কৰক\n"
"#\n"
"#\n"
