#: locationrunner.cpp:44
msgid ""
"Finds local directories and files, network locations and Internet sites with "
"paths matching :q:."
msgstr ""
":q: -ৰ হৈতে মিল খোৱা পথসমূহৰেস্থানীয় ডাইৰেকটৰি আৰু নথিপত্ৰসমূহ, নেটৱাৰ্ক "
"অৱস্থান আৰু "
"ইন্টাৰনেট ছাইটসমূহ বিচাৰক।"

#: locationrunner.cpp:115 locationrunner.cpp:137
#, kde-format
msgid "Open %1"
msgstr "%1 খোলক"

#: locationrunner.cpp:155 locationrunner.cpp:164
#, kde-format
msgid "Go to %1"
msgstr "%1 লে যাওক"

#: locationrunner.cpp:161
#, kde-format
msgid "Launch with %1"
msgstr "%1 -ৰ হৈতে লঞ্চ কৰক"


