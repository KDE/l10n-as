#: kfmclient.cpp:56
msgid "kfmclient"
msgstr "kfmclient"

#: kfmclient.cpp:57
msgid "KDE tool for opening URLs from the command line"
msgstr "URLসমূহ কমান্ড শাৰীৰ পৰা খোলিবলে KDE সঁজুলি"

#: kfmclient.cpp:75
msgid "Non interactive use: no message boxes"
msgstr "অভাৱবিনিময়ী ব্যৱহাৰ: কোনো বাৰ্তা বাকচ নাই"

#: kfmclient.cpp:77
msgid "Show available commands"
msgstr "উপলব্ধ কমান্ডসমূহ দেখুৱাওক"

#: kfmclient.cpp:79
msgid "Command (see --commands)"
msgstr "কমান্ড (চাওক --commands)"

#: kfmclient.cpp:81
msgid "Arguments for command"
msgstr "কমান্ডৰ বাবে তৰ্ক"

#: kfmclient.cpp:91
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"বাক্যবিন্যাস:\n"

#: kfmclient.cpp:92
msgid ""
"  kfmclient openURL 'url' ['mimetype']\n"
"            # Opens a window showing 'url'.\n"
"            #  'url' may be a relative path\n"
"            #   or file name, such as . or subdir/\n"
"            #   If 'url' is omitted, $HOME is used instead.\n"
"\n"
msgstr ""
"  kfmclient openURL 'url' ['mimetype']\n"
"            # 'url দেখুৱা এটা উইন্ডো খোলে।\n"
"            #  'url' এটা আনুষংগিক পথ\n"
"            #   অথবা নথিপত্ৰ নাম, যেনে . অথবা subdir/ হ'ব পাৰে\n"
"            #   যদি 'url' বাদ দিয়া হয়, $HOME পৰিৱৰ্তে ব্যৱহাৰ কৰা হ'ব।\n"
"\n"

#: kfmclient.cpp:97
msgid ""
"            # If 'mimetype' is specified, it will be used to determine the\n"
"            #   component that Konqueror should use. For instance, set it "
"to\n"
"            #   text/html for a web page, to make it appear faster\n"
"\n"
msgstr ""
"            # যদি 'mimetype' ধাৰ্য্য কৰা হয়, ইয়াক\n"
"            # Konqueror -এ ব্যৱহাৰ কৰিব লগিয়া উপাদান নিৰ্ধাৰন কৰিবলে ব্যৱহাৰ "
"কৰা হ'ব। উদাহৰনস্বৰুপে, ইয়াক \n"
"            # এটা ৱেব পৃষ্ঠাৰ বাবে text/html -লে সংহতি কৰক, ইয়াক দ্ৰুত দেখাবলে\n"
"\n"

#: kfmclient.cpp:101
msgid ""
"  kfmclient newTab 'url' ['mimetype']\n"
"            # Same as above but opens a new tab with 'url' in an existing "
"Konqueror\n"
"            #   window on the current active desktop if possible.\n"
"\n"
msgstr ""
"  kfmclient newTab 'url' ['mimetype']\n"
"            # উপৰত দিয়া দৰে একে কিন্তু এটা স্থায়ী Konqueror -ৰ  'url' -ৰ সৈতে "
"এটা নতুন টেব খোলে\n"
"            #  বৰ্তমান সক্ৰিয় ডেস্কটপত এটা উইন্ডো যদি সম্ভব।\n"
"\n"

#: kfmclient.cpp:105
msgid ""
"  kfmclient openProfile 'profile' ['url']\n"
"            # Opens a window using the given profile.\n"
"            #   'profile' is a file under ~/.kde/share/apps/konqueror/"
"profiles.\n"
"            #   'url' is an optional URL to open.\n"
"\n"
msgstr ""
"  kfmclient openProfile 'profile' ['url']\n"
"            # দিয়া আলেখ্যৰে এটা উইন্ডো খোলে।\n"
"            #   'profile'  হ'ল ~/.kde/share/apps/konqueror/আলেখ্যসমূহৰ অন্তৰ্গত "
"এটা নথিপত্ৰ।\n"
"            #   'url' হ'ল খোলিব লগিয়া এটা বৈকল্পিক URL।\n"
"\n"

#: kfmclient.cpp:110
msgid ""
"  kfmclient exec is deprecated and kept for compatibility with KDE 3. \n"
"            # See kioclient exec for more information.\n"
msgstr ""
"  kfmclient exec ডিপ্ৰিকেইট হৈছে আৰু KDE 3 -ৰ হৈতে খাপ খাবলে থোৱা হৈছে। \n"
"            # অধিক তথ্যৰ বাবে kioclient exec চাওক।\n"

#: kfmclient.cpp:471
#, kde-format
msgid "Profile %1 not found\n"
msgstr "আলেখ্য %1 পোৱা নগল\n"

#: kfmclient.cpp:502
msgid "Syntax Error: Not enough arguments\n"
msgstr "বাক্যবিন্যাস ত্ৰুটি: পৰ্যাপ্ত ত্ৰুটি নাই\n"

#: kfmclient.cpp:507
msgid "Syntax Error: Too many arguments\n"
msgstr "বাক্যবিন্যাস ত্ৰুটি: বহু বেছি তৰ্ক\n"

#: kfmclient.cpp:573
#, kde-format
msgid "Syntax Error: Unknown command '%1'\n"
msgstr "বাক্যবিন্যাস ত্ৰুটি: অজ্ঞাত কমান্ড '%1'\n"
