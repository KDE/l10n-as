#: kateconsole.cpp:55
msgid "Konsole"
msgstr "Konsole"

#: kateconsole.cpp:55
msgid "Embedded Konsole"
msgstr "অন্তৰ্ভুক্ত Konsole"

#: kateconsole.cpp:63
msgid "You do not have enough karma to access a shell or terminal emulation"
msgstr "আপোনাৰ এটা শ্বেল বা টাৰ্মিনেল ইমুলেশণ অভিগম কৰিবলে পৰ্যাপ্ত karma নাই"

#: kateconsole.cpp:89 kateconsole.cpp:114
msgid "Terminal"
msgstr "টাৰ্মিনেল"

#: kateconsole.cpp:95
msgid "Terminal Settings"
msgstr "টাৰ্মিনেল সংহতিসমূহ"

#: kateconsole.cpp:146
msgctxt "@action"
msgid "&Pipe to Terminal"
msgstr "টাৰ্মিনেললে পাইপ (&P)"

#: kateconsole.cpp:150
msgctxt "@action"
msgid "S&ynchronize Terminal with Current Document"
msgstr "বৰ্তমান দস্তাবেজৰ লগত টাৰ্মিনেল সংমিহলি কৰক (&y)"

#: kateconsole.cpp:155
msgctxt "@action"
msgid "&Focus Terminal"
msgstr "টাৰ্মিনেলত মনোনিবেষ কৰক (&F)"

#: kateconsole.cpp:239
msgid ""
"Do you really want to pipe the text to the console? This will execute any "
"contained commands with your user rights."
msgstr ""
"আপুনি সঁচাকে লিখনীক কনচললে পাইপ কৰিব বিচাৰে নে? ই আপোনাৰ ব্যৱহাৰকাৰী সুবিধাসমূহ "
"যিকোনো অন্তৰ্ভুক্ত কমান্ড প্ৰেৰণ কৰিব।"

#: kateconsole.cpp:240
msgid "Pipe to Terminal?"
msgstr "টাৰ্মিনেললে পাইপ কৰিব নে?"

#: kateconsole.cpp:241
msgid "Pipe to Terminal"
msgstr "টাৰ্মিনেললে পাইপ"

#: kateconsole.cpp:262
#, kde-format
msgid "Sorry, can not cd into '%1'"
msgstr "ক্ষমা কৰিব, '%1' লে cd কৰিব নোৱাৰি"

#: kateconsole.cpp:278 kateconsole.cpp:294
msgid "Defocus Terminal"
msgstr "টাৰ্মিনেলৰ পৰা মনোযোগ আতৰাওক"

#: kateconsole.cpp:287
msgid "Focus Terminal"
msgstr "টাৰ্মিনেলত মনোনিবেষ কৰক"

#: kateconsole.cpp:318
msgid ""
"&Automatically synchronize the terminal with the current document when "
"possible"
msgstr ""
"যেতিয়া সম্ভব তেতিয়া টাৰ্মিনেলক স্বচালিতভাৱে বৰ্তমান দস্তাবেজৰ লগত সংমিহলি কৰক (&A)"

#: kateconsole.cpp:320
msgid "Set &EDITOR environment variable to 'kate -b'"
msgstr "EDITOR পৰিৱেশ চলকক 'kate -b' লে সংহতি কৰক (&E)"

#: kateconsole.cpp:323
msgid ""
"Important: The document has to be closed to make the console application "
"continue"
msgstr "গুৰুত্বপূৰ্ণ: কনচল অনুপ্ৰয়োগ আগবঢ়ালে দস্তাবেজ বন্ধ কৰিব লাগিব"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "নীলমদ্যুতি গোস্বামী"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "ngoswami@redhat.com"

