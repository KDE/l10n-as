msgstr "আলেখ্য মচি দিয়ক"

#. i18n: file: profileEditPage.ui:71
#. i18n: ectx: property (text), widget (QWidget, scrollAreaWidgetContents)
#: rc.cpp:11
msgid "Import Profiles"
msgstr "আলেখ্যসমূহ ইমপোৰ্ট কৰক"

#. i18n: file: profileEditPage.ui:76
#. i18n: ectx: property (text), widget (QWidget, scrollAreaWidgetContents)
