#: ui/applet.cpp:451
msgid "Display"
msgstr "প্ৰদৰ্শন কৰক"

#: ui/applet.cpp:453
msgid "Choose which information to show"
msgstr "কোন তথ্য দেখুৱা হ'ব বাছক"

#: ui/applet.cpp:454
msgid "Entries"
msgstr "প্ৰবিষ্টিসমূহ"

#: ui/applet.cpp:514
msgctxt "Item will be automatically shown or hidden from the systray"
msgid "Auto"
msgstr "স্বচালিত"

#: ui/applet.cpp:515
msgctxt "Item is never visible in the systray"
msgid "Hidden"
msgstr "লুকাই থকা"

#: ui/applet.cpp:516
msgctxt "Item is always visible in the systray"
msgid "Always Visible"
msgstr "সদায় দৃশ্যমান"

#: ui/applet.cpp:556
msgctxt "Categories of items in the systemtray that will be shown or hidden"
msgid "Shown Item Categories"
msgstr "বস্তু বিভাগসমূহ দেখুৱাওক"

#: ui/applet.cpp:559
msgctxt "Systemtray items that describe the status of a generic application"
msgid "Application status"
msgstr "অনুপ্ৰয়োগ অৱস্থা"

#: ui/applet.cpp:569
msgctxt "Items communication related, such as chat or email clients"
msgid "Communications"
msgstr "যোগাযোগসমূহ"

#: ui/applet.cpp:579
msgctxt "Items about the status of the system, such as a filesystem indexer"
msgid "System services"
msgstr "চিস্টেম সেৱাসমূহ"

#: ui/applet.cpp:589
msgctxt "Items about hardware, such as battery or volume control"
msgid "Hardware control"
msgstr "হাৰ্ডৱেৰ নিয়ন্ত্ৰণ"

#: ui/applet.cpp:599
msgctxt "Other uncategorized systemtray items"
msgid "Miscellaneous"
msgstr "বিভিন্ন"

#: ui/applet.cpp:618
msgctxt ""
"Extra items to be manually added in the systray, such as little Plasma "
"widgets"
msgid "Extra Items"
msgstr "অতিৰিক্ত বস্তুবোৰ"

#: ui/taskarea.cpp:514
msgid "Hide icons"
msgstr "আইকনসমূহ লুকাওক"

#: ui/taskarea.cpp:516
msgid "Show hidden icons"
msgstr "লুকাই থকা আইকনসমূহ দেখুৱাওক"

#. i18n: file: ui/autohide.ui:39
#. i18n: ectx: property (text), widget (QTreeWidget, icons)
#: rc.cpp:3
msgid "Item"
msgstr "বস্তু"

#. i18n: file: ui/autohide.ui:44
#. i18n: ectx: property (text), widget (QTreeWidget, icons)
#: rc.cpp:6
msgid "Visibility"
msgstr "দৃশ্যমানতা"

#. i18n: file: ui/autohide.ui:49
#. i18n: ectx: property (text), widget (QTreeWidget, icons)
#: rc.cpp:9
msgid "Keyboard Shortcut"
msgstr "কিবৰ্ড চৰ্টকাট"

#. i18n: file: ui/visibleitems.ui:26
#. i18n: ectx: property (text), widget (QLabel, unlockLabel)
#: rc.cpp:12
msgid "Widgets are currently locked, disabling some options."
msgstr "উইজেটসমূহ বৰ্তমান লক কৰা আছে, কিছুমান বিকল্প অসামৰ্থবান কৰি।"

#. i18n: file: ui/visibleitems.ui:54
#. i18n: ectx: property (text), widget (QPushButton, unlockButton)
#: rc.cpp:15
msgid "Unlock Widgets"
msgstr "উইজেটসমূহ আনলক কৰক"
